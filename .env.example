# A hostname enables Caddy-managed HTTPS. Keep http://localhost for local evaluation.
LORI_ADDRESS=lori.acme.com

# Optional port overrides. When changed, use the same explicit port in
# LORI_ADDRESS so Caddy, trusted origins, invite links, and desktop enrollment
# all share one canonical address.
LORI_HTTP_PORT=80
LORI_HTTPS_PORT=443

# Run one deployment as a hosted cloud: anyone can create an individual or
# enterprise account, with no operator setup token. Each account is a separate
# tenant. Leave false for a company's own self-hosted deployment.
# LORI_PUBLIC_SIGNUP=false

# Optional: context and reply limits for Cloud Work models it does not already
# know (published OpenAI models such as gpt-6-luna are built in). JSON keyed
# "provider:model"; contextTokens 4096-4000000, outputTokens below it (replies
# are capped at 16384). Unlisted models use a conservative 32768 / 4096.
# WORK_CLOUD_MODEL_LIMITS={"openrouter:vendor/model":{"contextTokens":200000,"outputTokens":8192}}
# Built-in public web search/page reading via Exa. Anonymous use has provider rate limits.
WORK_CLOUD_WEB_RESEARCH_ENABLED=true
# Optional dedicated Exa key for production capacity; kept on the API server.
# WORK_CLOUD_RESEARCH_API_KEY=

# Optional: minutes an unanswered Cloud Work approval holds a run before it
# expires and the run continues without the action (1-1440, default 15).
# WORK_CLOUD_APPROVAL_TIMEOUT_MINUTES=15

# Optional: personal projects (owner-only folders for a member's own chats).
# Retained projects per member, archived and recoverable-deleted included
# (1-1000, default 100; an administrator can set a different limit in Settings),
# and the days a deleted project and its chats stay recoverable (1-365, default 30).
# WORK_CLOUD_PERSONAL_PROJECT_LIMIT=100
# WORK_CLOUD_PERSONAL_PROJECT_RECOVERY_DAYS=30

# Optional: runs each work-worker serves at once (1-16, default 4). A run
# waiting for an approval no longer blocks the others. Each run can use the
# worker's memory and scratch space, so raise LORI_WORKER_MEMORY_LIMIT with it.
# WORK_CLOUD_WORKER_CONCURRENCY=4

# Optional: semantic Work memory. A pinned multilingual model ships inside the API
# image and runs locally in a supervised CPU process; nothing leaves the deployment.
# Set to "off" to restore lexical-only retrieval without touching saved memory.
# LORI_SEMANTIC_MEMORY=on
# CPU threads for embedding (1-4, default 1).
# LORI_SEMANTIC_THREADS=1

# Pin released images here when the package is published.
LORI_VERSION=local
# Production releases use digest-pinned references with compose.release.yaml.
# LORI_ENTERPRISE_API_IMAGE=registry.example/lori-enterprise-api@sha256:...
# LORI_ENTERPRISE_WEB_IMAGE=registry.example/lori-enterprise-web@sha256:...
