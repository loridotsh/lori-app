[
  {
    "id": "filesystem",
    "name": "Filesystem",
    "description": "Let agents read and write files in folders you allow.",
    "category": "mcp",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "${HOME}"],
    "env": {}
  },
  {
    "id": "postgres",
    "name": "Postgres",
    "description": "Query PostgreSQL databases from your agent.",
    "category": "mcp",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-postgres"],
    "env": {
      "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}"
    },
    "requires_auth": true
  },
  {
    "id": "brave-search",
    "name": "Brave Search",
    "description": "Search the web with Brave.",
    "category": "mcp",
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-brave-search"],
    "env": {
      "BRAVE_API_KEY": "${BRAVE_API_KEY}"
    },
    "requires_auth": true
  }
]
