# Required: public URL members use (include https:// for production).
LORI_ADDRESS=https://lori.example.com

# Optional: change only for local HTTP trials (see deploy/OPERATOR.md).
# LORI_HTTP_PORT=8180
# LORI_HTTPS_PORT=8443

# Set automatically when using a versioned OCI Compose stack (v0.2.0).
LORI_VERSION=0.2.0
